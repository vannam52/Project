# ─────────────────────────────────────────
# Copy file này thành .env và điền giá trị
# cp .env.example .env
# ─────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=videosubtitle
POSTGRES_USER=vsuser
POSTGRES_PASSWORD=your_strong_password_here

# RabbitMQ
RABBITMQ_USER=vsrabbit
RABBITMQ_PASS=your_rabbitmq_password_here

# MinIO
MINIO_ROOT_USER=vsminio
MINIO_ROOT_PASSWORD=your_minio_password_here

# Whisper Model: tiny | base | small | medium | large-v3
# tiny = nhanh nhất, kém chính xác nhất
# large-v3 = chậm nhất, chính xác nhất (cần GPU)
WHISPER_MODEL=base

# Translation Provider: google | deepl | gemini
TRANSLATION_PROVIDER=google

# API Keys (điền provider bạn chọn)
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
GEMINI_API_KEY=

# JWT (cho authentication sau này)
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRY_MINUTES=1440
